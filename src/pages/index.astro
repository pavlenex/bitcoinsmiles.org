      .d-1 {
        top: -5px;
        animation: dotOn linear both;
        animation-timeline: --origin;
        animation-range: contain 0% contain 3%;
      }
      .d-2 {
        top: calc(50% - 6px);
        animation: dotOn linear both;
        animation-timeline: --origin;
        animation-range: contain 28% contain 31%;
      }
      .d-3 {
        bottom: -5px;
        animation: dotOn linear both;
        animation-timeline: --origin;
        animation-range: contain 56% contain 59%;
      }
      @keyframes sceneIn {
