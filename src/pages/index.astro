<script>
  // Animate counters once when the section enters the viewport.
  const numbers = document.querySelector('.numbers');
  const counters = [...document.querySelectorAll<HTMLElement>('.count')];
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (numbers && counters.length && !reducedMotion) {
    const fmt = (v: number, dec: number) =>
      dec ? v.toFixed(dec) : Math.round(v).toLocaleString('en-US');
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        counters.forEach((el, i) => {
          const target = parseFloat(el.dataset.count ?? '0');
          const dec = Number(el.dataset.decimals ?? 0);
          const start = performance.now() + i * 240;
          const tick = (t: number) => {
            const p = Math.min(1, Math.max(0, (t - start) / 1400));
            el.textContent = fmt(target * (1 - (1 - p) ** 3), dec);
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      },
      { threshold: 0.3 }
    );
    io.observe(numbers);
  }
</script>
