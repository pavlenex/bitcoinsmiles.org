---
import { Image } from 'astro:assets';
import { FILM_YOUTUBE_ID } from '../consts';
import filmStill from '../photos/site/clinic.webp';

// Full-bleed ambient film, pinned for 200vh of scroll.
// Poster-first: the clinic still is the section's face. The YouTube iframe is
// injected only when scrolled near, kept invisible, and faded in only once the
// player reports it is actually playing — so YouTube's error/bot screens can
// never appear. If the video can't play, the still simply stays.
const watchUrl = `https://www.youtube.com/watch?v=${FILM_YOUTUBE_ID}`;
---

<section class="film" data-film data-video-id={FILM_YOUTUBE_ID}>
  <div class="pin">
    <div class="poster">
      <Image src={filmStill} alt="" widths={[960, 1440, 1920]} sizes="100vw" loading="lazy" />
    </div>
    <div class="frame" data-film-frame></div>
    <div class="shade"></div>
    <div class="copy">
      <h2>Watch the smiles come back</h2>
      <div class="row">
        <p>
          For some neighbours around El Zonte, cost and distance had kept dental care out of reach
          for decades. Bitcoin Smiles brought a global community into Enrique's small clinic.
        </p>
        <a class="watch" href={watchUrl} target="_blank" rel="noopener">Watch with sound</a>
      </div>
    </div>
  </div>
</section>

<style>
  .film { background: var(--ink); }
  .pin {
    position: sticky;
    top: 0;
    min-height: 100vh;
    overflow: hidden;
    background: var(--ink);
  }
  .poster,
  .poster img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .poster::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(10, 10, 10, 0.45);
  }
  .frame :global(iframe) {
    position: absolute;
    left: 50%;
    top: 50%;
    width: max(100vw, 178vh);
    height: max(56.25vw, 100vh);
    transform: translate(-50%, -50%);
    pointer-events: none;
    border: 0;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .frame :global(iframe.is-playing) { opacity: 1; }
  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(10, 10, 10, 0.85) 0%,
      rgba(10, 10, 10, 0.05) 55%,
      rgba(10, 10, 10, 0.35) 100%
    );
    pointer-events: none;
  }
  .copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0 var(--pad-x) 56px;
    color: #fff;
  }
  h2 {
    font-size: clamp(32px, 4.4vw, 72px);
    line-height: 1;
    text-transform: uppercase;
    margin: 0;
    max-width: 18ch;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 30px;
    flex-wrap: wrap;
    margin-top: 22px;
  }
  p {
    font-size: clamp(15px, 1.3vw, 18px);
    line-height: 1.6;
    margin: 0;
    max-width: 46ch;
    color: rgba(255, 255, 255, 0.78);
  }
  .watch {
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.5);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 14px 26px;
    white-space: nowrap;
  }
  .watch:hover { color: #fff; border-color: #fff; }
  @media (max-width: 640px) {
    .copy { padding: 0 24px 40px; }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .film {
        height: 200vh;
        view-timeline: --film block;
      }
      .pin { height: 100vh; }
      h2 {
        animation: chunk linear both;
        animation-timeline: --film;
        animation-range: contain 5% contain 30%;
      }
      p {
        animation: chunk linear both;
        animation-timeline: --film;
        animation-range: contain 10% contain 38%;
      }
      .watch {
        animation: chunk linear both;
        animation-timeline: --film;
        animation-range: contain 14% contain 42%;
      }
    }
  }
</style>

<script>
  const YT_ORIGIN = 'https://www.youtube-nocookie.com';
  const section = document.querySelector<HTMLElement>('[data-film]');
  const frame = section?.querySelector<HTMLElement>('[data-film-frame]');

  if (section && frame) {
    const id = section.dataset.videoId;
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Fade the iframe in only once YouTube reports playerState 1 (playing).
    const revealWhenPlaying = (iframe: HTMLIFrameElement) => {
      const onMessage = (e: MessageEvent) => {
        if (e.origin !== YT_ORIGIN || e.source !== iframe.contentWindow) return;
        if (typeof e.data !== 'string') return;
        try {
          const msg = JSON.parse(e.data);
          const state = msg.event === 'onStateChange' ? msg.info : msg.info?.playerState;
          if (state === 1) {
            iframe.classList.add('is-playing');
            removeEventListener('message', onMessage);
          }
        } catch {
          /* not a player message */
        }
      };
      addEventListener('message', onMessage);
      iframe.addEventListener('load', () => {
        // Handshake that asks the embed to start posting state events.
        iframe.contentWindow?.postMessage(
          JSON.stringify({ event: 'listening', id: 'film', channel: 'widget' }),
          YT_ORIGIN
        );
      });
    };

    const load = () => {
      const iframe = document.createElement('iframe');
      const base = `enablejsapi=1&origin=${encodeURIComponent(location.origin)}&playsinline=1&rel=0&modestbranding=1`;
      iframe.title = 'Bitcoin Smiles film';
      iframe.allow = 'autoplay; encrypted-media';
      if (reducedMotion) {
        // No autoplay: show a standard, clickable player instead.
        iframe.src = `${YT_ORIGIN}/embed/${id}?${base}&controls=1`;
        iframe.style.pointerEvents = 'auto';
        iframe.style.opacity = '1';
      } else {
        iframe.src = `${YT_ORIGIN}/embed/${id}?${base}&autoplay=1&mute=1&loop=1&playlist=${id}&controls=0`;
        revealWhenPlaying(iframe);
      }
      frame.appendChild(iframe);
    };

    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          load();
        }
      },
      { rootMargin: '600px 0px' }
    );
    io.observe(section);
  }
</script>
