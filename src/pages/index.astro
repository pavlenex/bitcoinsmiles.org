        animation: chunk linear both;
        animation-timeline: view();
        animation-range: entry 25% entry 75%;
      }
      .origin {
        height: 400vh;
        view-timeline: --origin block;
      }
      .origin-pin {
        position: sticky;
        top: 0;
        height: 100vh;
        overflow: hidden;
      }
      .origin-frame {
        height: 100%;
        display: grid;
        grid-template-columns: clamp(120px, 12vw, 170px) minmax(0, 1.02fr) minmax(0, 0.98fr);
