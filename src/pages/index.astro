      .beats { position: relative; }
      .chapter { position: absolute; inset: 0; }
      .beat-copy {
        height: 380px;
        justify-content: space-between;
      }
      .stage { padding: 0 48px 0 0; }
      /* The scene accumulates: clinic appears with beat two, the network and
         its streaming sats with beat three, and everything stays. */
      .layer-clinic,
      .layer-network {
        animation: sceneIn linear both;
        animation-timeline: --origin;
      }
      .layer-clinic { animation-range: contain 26% contain 36%; }
      .layer-network { animation-range: contain 54% contain 64%; }
      /* Timeline rail: progress fill scrubbed by the section, dots light up
         as their beat lands, and each dot is a jump link. */
      .rail {
        display: block;
        position: relative;
        align-self: center;
        height: 380px;
        margin-left: 48px;
      }
      .rail-line {
        position: absolute;
        left: 5px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: rgba(255, 255, 255, 0.18);
      }
      .rail-fill {
        position: absolute;
        inset: 0;
        background: #fff;
        transform: scaleY(0);
        transform-origin: top;
        animation: railGrow linear both;
        animation-timeline: --origin;
        animation-range: contain 0% contain 64%;
      }
      .dot {
        position: absolute;
        left: 0;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        border: 1.5px solid rgba(255, 255, 255, 0.45);
