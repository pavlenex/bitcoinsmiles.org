---
import { DONATE_URL } from '../consts';

// Closing donate section shared by every page.
const socials = [
  { label: '@BitcoinSmiles', aria: 'Bitcoin Smiles on X', url: 'https://x.com/BitcoinSmiles', icon: 'x' },
  { label: '@DienteZonte', aria: 'Diente Zonte on X', url: 'https://x.com/DienteZonte', icon: 'x' },
  { label: 'GitHub', aria: 'Site source on GitHub', url: 'https://github.com/pavlenex/bitcoinsmiles.org', icon: 'github' },
];
---

<footer>
  <div class="inner">
    <p class="mono open">Fund the next appointment</p>
    <h2>Make someone smile</h2>
    <div class="cta-row">
      <a class="cta" href={DONATE_URL} target="_blank" rel="noopener">Donate in Bitcoin</a>
    </div>
    <div class="socials">
      {socials.map(({ label, aria, url, icon }) => (
        <a class="social" href={url} target="_blank" rel="noopener" aria-label={aria}>
          {icon === 'x' ? (
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          ) : (
            <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
            </svg>
          )}
          <span class="mono social-label">{label}</span>
        </a>
      ))}
    </div>
  </div>
</footer>

<style>
  footer { background: var(--ink); color: #fff; }
  .inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 110px var(--pad-x) 90px;
    text-align: center;
  }
  .open { color: var(--muted-on-dark); }
  h2 {
    font-size: clamp(52px, 8vw, 150px);
    line-height: 0.9;
    text-transform: uppercase;
    margin: 24px 0 0;
  }
  .cta-row { display: flex; justify-content: center; margin-top: 44px; }
  .cta {
    text-decoration: none;
    background: #fff;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 21px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 20px 54px;
  }
  .cta:hover { color: var(--ink); background: #ececec; }
  .socials {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    column-gap: clamp(28px, 4vw, 48px);
    row-gap: 20px;
    margin-top: 90px;
  }
  .social {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    color: var(--muted-on-dark);
  }
  .social:hover { color: #fff; }
  .social-label {
    font-size: 11px;
    letter-spacing: 0.14em;
    color: inherit;
  }
  @media (max-width: 640px) {
    .inner { padding: 80px 24px 60px; }
  }
</style>
