---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NeighbourhoodMap from '../components/NeighbourhoodMap.astro';
import Film from '../components/Film.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';
import { afterPhoto, beforePhoto } from '../lib/photos';
import { SITE_NAME, monthYear } from '../consts';
import enriquePhoto from '../photos/site/enrique.jpg';

import bitcoinCa from '../photos/supporters/bitcoin-ca.png';
import peakshift from '../photos/supporters/peakshift.png';
import square from '../photos/supporters/square.png';
import swan from '../photos/supporters/swan.png';
import theBitcoinCompany from '../photos/supporters/the-bitcoin-company.png';
import theBiz from '../photos/supporters/the-biz.png';
import walletOfSatoshi from '../photos/supporters/wallet-of-satoshi.png';
import bitcoinMagazine from '../photos/press/bitcoinmagazine.png';
import beInCrypto from '../photos/press/beincrypto.png';
import bitmymoney from '../photos/press/bitmymoney.png';

const patients = (await getCollection('patients')).sort((a, b) => a.data.order - b.data.order);

// Deterministic scatter for The smiles: the original wall choreography — every
// card converges on the grid together as the section arrives, each with its own
// flight path and landing moment, from a fixed seed so every patient —
// including ones added later — gets a card without anyone editing CSS.
function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = mulberry32(20210903);
const smiles = patients.map((p) => ({
  patient: p,
  photo: afterPhoto(p.id),
  style: [
    `--tx:${Math.round(rand() * 121 - 64)}vw`,
    `--ty:${Math.round(56 + rand() * 60)}vh`,
    `--tr:${Math.round(rand() * 34 - 18)}deg`,
    `--ts:${(1.5 + rand() * 1.15).toFixed(2)}`,
    `--re:${5 + Math.round(rand() * 15)}%`,
  ].join(';'),
}));

// The metrics converge the same chaotic way the smiles cards do.
const metricScatter = Array.from({ length: 5 }, (_, i) =>
  [
    `--tx:${Math.round(rand() * 81 - 40)}vw`,
    `--ty:${Math.round(40 + rand() * 50)}vh`,
    `--tr:${Math.round(rand() * 28 - 14)}deg`,
    `--ts:${(1.2 + rand() * 0.6).toFixed(2)}`,
    `--re:${42 + i * 13}%`,
  ].join(';')
);

const patientName = new Map(patients.map((p) => [p.id, p.data.name]));
const comparisons = ['antonia', 'arcely', 'blanca'].map((slug) => ({
  slug,
  name: patientName.get(slug) ?? slug,
  before: beforePhoto(slug)!,
  after: afterPhoto(slug),
}));

const supporters = [
  { img: bitcoinCa, name: 'Bitcoin CA' },
  { img: peakshift, name: 'Peakshift' },
  { img: square, name: 'Square' },
  { img: swan, name: 'Swan' },
  { img: theBitcoinCompany, name: 'The Bitcoin Company' },
  { img: theBiz, name: 'The Biz' },
  { img: walletOfSatoshi, name: 'Wallet of Satoshi' },
];
const press = [
  { img: bitcoinMagazine, name: 'Bitcoin Magazine' },
  { img: beInCrypto, name: 'BeInCrypto' },
  { img: bitmymoney, name: 'Bitmymoney' },
];
---

<Base title={`${SITE_NAME} — Bring smiles back to the neighbourhood`}>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <h1>Bring smiles back to the neighbourhood</h1>
        <p>
          One dentist in the jungle of El Zonte, thousands of strangers on the internet, and a
          Bitcoin fund that four years later still pays for every appointment.
        </p>
      </div>
      <div class="hero-map">
        <NeighbourhoodMap />
      </div>
    </div>
  </section>

  <!-- How it all started: pinned scrollytelling — copy left, one hand-drawn
       scene right that gains elements as the story advances, clickable
       timeline rail for orientation -->
  <section class="origin" aria-label="How it all started">
    <div class="beat-anchor" id="beat-1"></div>
    <div class="beat-anchor" id="beat-2"></div>
    <div class="beat-anchor" id="beat-3"></div>
    <div class="origin-pin">
      <div class="origin-frame">
        <nav class="rail" aria-label="Story beats">
          <span class="rail-line" aria-hidden="true"><span class="rail-fill"></span></span>
          <a class="dot d-1" href="#beat-1"><span>the village</span></a>
          <a class="dot d-2" href="#beat-2"><span>the dentist</span></a>
          <a class="dot d-3" href="#beat-3"><span>the idea</span></a>
        </nav>
        <div class="beats">
          <div class="chapter ch-1">
            <div class="beat-copy">
              <p class="figure">El Zonte, 2021</p>
              <p class="desc">
                A surf village in El Salvador starts running on Bitcoin. In the hills behind the
                beach, work is paid by the day — and a bad tooth still costs a day's pay.
              </p>
            </div>
          </div>
          <div class="chapter ch-2">
            <div class="beat-copy">
              <p class="figure">One dentist</p>
              <p class="desc">
                Enrique Berrios had been the area's only dentist for sixteen years, in a clinic
                six metres by four, treating neighbours who could not pay.
              </p>
            </div>
          </div>
          <div class="chapter ch-3">
            <div class="beat-copy">
              <p class="figure">One idea</p>
              <p class="desc">
                Put the clinic on the internet: raise one Bitcoin on free software, and let
                strangers pay for the neighbours' teeth. Zero fees, zero middlemen.
              </p>
            </div>
          </div>
        </div>
        <div class="stage" aria-hidden="true">
          <div class="scene-stack">
            <svg viewBox="0 0 380 310" class="scene">
              <g class="scene-base" fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6">
              <circle cx="314" cy="48" r="15" stroke="#f0a71f" stroke-width="2"></circle>
              <circle cx="309" cy="44" r="1.4" fill="#f0a71f" stroke="none"></circle>
              <circle cx="319" cy="44" r="1.4" fill="#f0a71f" stroke="none"></circle>
              <path d="M308,52 Q314,57 320,52" stroke="#f0a71f" stroke-width="1.4"></path>
              <path d="M314,22 L314,13 M314,74 L314,83 M288,48 L279,48 M340,48 L349,48 M296,30 L290,24 M332,30 L338,24 M296,66 L290,72 M332,66 L338,72" stroke="#f0a71f" stroke-width="2"></path>
              <path d="M52,138 h30 v22 h-30 z M48,138 L67,121 L86,138 M60,160 v-10 h8 v10"></path>
              <path d="M150,168 h26 v19 h-26 z M147,168 L163,154 L179,168"></path>
              <path d="M233,128 h24 v18 h-24 z M230,128 L245,115 L260,128 M239,146 v-8 h6 v8"></path>
              <path d="M108,190 C106,176 110,166 110,162 M110,162 C100,158 96,150 98,146 M110,162 C120,158 124,150 122,146 M110,162 C106,152 108,146 112,142 M110,162 C102,164 96,162 92,156 M110,162 C118,166 126,164 130,158" stroke="#2e7d32" stroke-width="1.5"></path>
              <path d="M300,182 C298,170 302,162 302,158 M302,158 C294,155 291,148 293,145 M302,158 C310,155 313,148 311,145 M302,158 C298,150 300,145 303,142 M302,158 C295,160 290,158 287,153 M302,158 C309,161 315,159 318,154" stroke="#2e7d32" stroke-width="1.5"></path>
              <path d="M28,214 L28,168" stroke-width="1.8"></path>
              <path d="M29,171 C41,169 54,172 65,170 L64,178 C53,180 40,177 29,179 z" fill="#0047ab" fill-opacity="0.85" stroke="#0047ab" stroke-width="1.2"></path>
              <path d="M29,179 C40,177 53,180 64,178 L63,186 C52,188 39,185 29,187 z" fill="#ffffff" stroke="#fff" stroke-opacity="0.4" stroke-width="1"></path>
              <path d="M29,187 C39,185 52,188 63,186 L62,194 C51,196 38,193 29,195 z" fill="#0047ab" fill-opacity="0.85" stroke="#0047ab" stroke-width="1.2"></path>
              <path d="M10,236 C80,224 165,244 250,232 C320,224 352,238 372,232" stroke-width="1.4"></path>
              <path d="M36,262 Q48,253 60,262 M104,272 Q116,263 128,272 M180,258 Q192,249 204,258 M256,272 Q268,263 280,272 M322,260 Q334,251 346,260" stroke="#2f6fbd" stroke-width="1.8" opacity="0.85"></path>
              <text x="196" y="292" font-size="19" fill="#9a9a9a" class="hand" stroke="none">the beach</text>
            </g>
            </svg>
            <div class="layer layer-clinic">
              <svg viewBox="0 0 380 310" class="scene">
                <g class="scene-clinic" fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round">
              <path d="M318,184 h38 v28 h-38 z" stroke-width="1.8"></path>
              <path d="M313,184 L337,163 L361,184" stroke-width="1.8"></path>
              <path d="M330,194 c0,-4.8 3,-7.8 7,-7.8 c4,0 7,3 7,7.8 c0,3 -1.1,5.1 -2,7.2 c-1,2.4 -1,5.1 -1.6,7.5 c-0.4,1.6 -2.2,1.7 -2.5,0 c-0.4,-1.9 -0.4,-4.2 -1.9,-4.2 c-1.5,0 -1.4,2.3 -1.9,4.2 c-0.3,1.7 -2.1,1.6 -2.5,0 c-0.6,-2.4 -0.6,-5.1 -1.6,-7.5 c-0.9,-2.1 -2,-4.2 -2,-7.2 z" stroke="none" fill="#fff"></path>
              <g transform="translate(150,46) scale(0.75)" stroke-width="1.9">
                <circle cx="158" cy="172" r="10"></circle>
                <path d="M150,166 Q154,160 158,164 Q162,160 166,166 M151,164 l-4,-5 M154,162 l-2,-6 M158,161 l0,-7 M162,162 l2,-6 M165,164 l4,-5"></path>
                <circle cx="154.5" cy="170" r="1.2" fill="#fff" stroke="none"></circle>
                <circle cx="161.5" cy="170" r="1.2" fill="#fff" stroke="none"></circle>
                <path d="M153,175 Q158,180 163,175"></path>
                <path d="M152,182 L148,210 L168,210 L164,182 M152,182 Q158,186 164,182 M158,188 L158,208"></path>
                <circle cx="155" cy="194" r="0.9" fill="#fff" stroke="none"></circle>
                <circle cx="155" cy="200" r="0.9" fill="#fff" stroke="none"></circle>
                <path d="M152,186 C146,184 142,180 139,175 M139,175 l-7,-7 M134,166 l3.4,3.4 M136.5,163.5 l3.4,3.4 M139,161 l3.4,3.4"></path>
                <path d="M164,186 C170,188 174,192 176,196 M176,196 a3.6,3.6 0 1 0 0.1,0"></path>
                <path d="M152,210 L151,222 M165,210 L166,222 M151,222 l-5,1 M166,222 l5,1"></path>
              </g>
              <text x="252" y="230" font-size="17" fill="#9a9a9a" class="hand" stroke="none">Enrique</text>
            </g>
              </svg>
            </div>
            <div class="layer layer-network">
              <svg viewBox="0 0 380 310" class="scene">
                <g class="scene-network">
              <g fill="none" stroke="#fff" stroke-linecap="round" stroke-width="1.5">
                <circle cx="48" cy="30" r="5.5"></circle>
                <circle cx="150" cy="16" r="5.5"></circle>
                <circle cx="244" cy="24" r="5.5"></circle>
                <circle cx="26" cy="112" r="5.5"></circle>
                <circle cx="352" cy="108" r="5.5"></circle>
              </g>
              <g fill="none" stroke="#fff" stroke-width="1" opacity="0.3" stroke-dasharray="3 5">
                <path d="M54,32 L144,18"></path>
                <path d="M156,17 L238,23"></path>
                <path d="M46,36 L28,106"></path>
                <path d="M250,26 C290,50 330,80 348,103"></path>
              </g>
              <g fill="none" stroke="#fff" stroke-width="0.8" opacity="0.22" stroke-dasharray="2 6">
                <path id="satp1" d="M48,30 C120,70 220,110 330,172"></path>
                <path id="satp2" d="M352,108 C346,132 340,150 336,168"></path>
                <path id="satp3" d="M26,112 C100,160 210,180 316,184"></path>
                <path id="satp4" d="M244,24 C270,80 300,130 332,168"></path>
              </g>
              <g class="sats" fill="#f0a71f" stroke="none">
                <circle r="3"><animateMotion dur="3.6s" repeatCount="indefinite"><mpath href="#satp1"></mpath></animateMotion></circle>
                <circle r="3"><animateMotion dur="3.6s" begin="-1.8s" repeatCount="indefinite"><mpath href="#satp1"></mpath></animateMotion></circle>
                <circle r="3"><animateMotion dur="2.6s" begin="-0.9s" repeatCount="indefinite"><mpath href="#satp2"></mpath></animateMotion></circle>
                <circle r="3"><animateMotion dur="4s" repeatCount="indefinite"><mpath href="#satp3"></mpath></animateMotion></circle>
                <circle r="3"><animateMotion dur="4s" begin="-2.1s" repeatCount="indefinite"><mpath href="#satp3"></mpath></animateMotion></circle>
                <circle r="3"><animateMotion dur="3.2s" begin="-1.4s" repeatCount="indefinite"><mpath href="#satp4"></mpath></animateMotion></circle>
              </g>
              <text x="40" y="12" font-size="15" fill="#9a9a9a" class="hand">strangers on the internet</text>
            </g>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The numbers: a loud stats band — hard rules, indexed cells, counters
       that roll up as the tiles land one by one -->
  <section class="numbers" aria-label="What the internet did">
    <div class="numbers-inner">
      <div class="metrics">
        <div class="metric m-1" style={metricScatter[0]}>
          <p class="mono idx">01</p>
          <p class="figure"><span class="count" data-count="2741">2,741</span> people</p>
          <p class="mono caption">from all over the internet funded it</p>
        </div>
        <div class="metric m-2" style={metricScatter[1]}>
          <p class="mono idx">02</p>
          <p class="figure"><span class="count" data-count="1.9" data-decimals="1">1.9</span> BTC</p>
          <p class="mono caption">raised on free software · the goal was 1 · zero fees, zero middlemen</p>
        </div>
        <div class="metric m-3" style={metricScatter[2]}>
          <p class="mono idx">03</p>
          <p class="figure"><span class="count" data-count="250">250</span>+</p>
          <p class="mono caption">patients treated in Enrique's chair, free of charge</p>
        </div>
        <div class="metric m-4" style={metricScatter[3]}>
          <p class="mono idx">04</p>
          <p class="figure"><span class="count" data-count="66">66</span></p>
          <p class="mono caption">
            neighbours who had lost every tooth — complete-denture rehabilitations, 132 dentures
            built from scratch
          </p>
        </div>
        <div class="metric m-5" style={metricScatter[4]}>
          <p class="mono idx">05</p>
          <p class="figure"><span class="count" data-count="200">200</span></p>
          <p class="mono caption">children given preventive check-ups before the damage starts</p>
        </div>
      </div>
    </div>
  </section>

  <!-- The smiles: every patient, scattering into the record as you scroll -->
  <section class="smiles" id="smiles">
    <div class="smiles-inner">
      <h2 class="reveal" style="--r0:12%;--r1:45%">The smiles</h2>
      <div class="grid">
        {smiles.map(({ patient, photo, style }) => (
          <a class="card" href={`/patients/${patient.id}/`} style={style}>
            <div class="photo">
              <Image
                src={photo}
                alt={patient.data.name}
                widths={[300, 600]}
                sizes="(max-width: 520px) 44vw, (max-width: 1100px) 30vw, 300px"
              />
            </div>
            <div class="meta">
              <p class="name">{patient.data.name}</p>
              <p class="date">{monthYear(patient.data.date)}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Enrique -->
  <section class="enrique">
    <div class="enrique-inner">
      <p class="mono head">The hands that did the work</p>
      <h2>Enrique Berrios</h2>
      <div class="enrique-grid">
        <figure class="portrait">
          <Image
            src={enriquePhoto}
            alt="Dr. Enrique Berrios in his dental chair"
            widths={[287]}
            sizes="(max-width: 700px) 80vw, 340px"
          />
          <figcaption class="mono credit">Dr. Enrique Berrios · Diente Zonte</figcaption>
        </figure>
        <div class="bio">
          <p class="quote">
            "Surrounded by colourful birds, mango trees, snakes and insects, and of course the
            blue sky and ocean."
          </p>
          <p class="about">
            The area's only dentist for sixteen years. His clinic is six metres by four, jungle on
            every side. He treated neighbours who could not pay long before anyone said the word
            Bitcoin to him. Every treatment in this report happened in his chair.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Film />

  <!-- Where it went -->
  <section class="went">
    <div class="went-inner">
      <p class="mono reveal">Where it went</p>
      <h2 class="reveal" style="--r0:15%;--r1:55%">Four years of appointments, one fund</h2>
      <div class="comparisons">
        {comparisons.map(({ slug, name, before, after }) => (
          <div class="reveal" style="--r0:10%;--r1:55%">
            <BeforeAfterSlider {before} {after} {name} sizes="(max-width: 700px) 92vw, 430px" />
          </div>
        ))}
      </div>
      <p class="mono records">
        From the clinic's records · drag to compare · published with permission
      </p>
    </div>
  </section>

  <!-- Supporters & press -->
  <section class="backers">
    <div class="backers-inner">
      <p class="mono head-dark">Supported by</p>
      <div class="logos supporters">
        {supporters.map(({ img, name }) => (
          <img src={img.src} width={img.width} height={img.height} alt={name} loading="lazy" />
        ))}
      </div>
      <p class="mono head-dark">Written about in</p>
      <div class="logos press">
        {press.map(({ img, name }) => (
          <img src={img.src} width={img.width} height={img.height} alt={name} loading="lazy" />
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* --- Hero --- */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    padding-top: clamp(64px, 9vh, 110px);
  }
  .hero-inner {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(28px, 4vw, 50px);
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
    padding: 0 var(--pad-x) 30px;
  }
  .hero-copy { flex: 0.9 1 320px; min-width: 0; }
  h1 {
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: clamp(46px, 6.4vw, 108px);
    line-height: 0.98;
    margin: 0;
    max-width: 14ch;
  }
  .hero-copy p {
    font-size: clamp(16px, 1.4vw, 20px);
    line-height: 1.65;
    margin: 34px 0 0;
    max-width: 50ch;
    color: var(--body-text);
  }
  .hero-map { flex: 1.35 1 420px; min-width: 0; }

  /* --- The smiles --- */
  .smiles {
    background: var(--paper);
    padding: 120px var(--pad-x);
    /* Cards fly in from outside their boxes; keep the flight inside the section. */
    overflow: clip;
  }
  .smiles-inner { max-width: 1400px; margin: 0 auto; }
  .smiles h2 {
    font-size: clamp(48px, 8vw, 140px);
    line-height: 0.9;
    text-transform: uppercase;
    margin: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
    margin-top: 56px;
  }
  .card {
    text-decoration: none;
    color: var(--ink);
    display: block;
  }
  .photo { overflow: hidden; background: #efefef; }
  .photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 0.85;
    object-fit: cover;
    display: block;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 10px;
    gap: 10px;
  }
  .name { font-size: 14.5px; font-weight: 700; margin: 0; }
  .date {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 640px) {
    .smiles { padding: 90px 24px; }
    .grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  }

  /* --- Enrique --- */
  .enrique {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 120px var(--pad-x);
    background: var(--ink);
    color: #fff;
  }
  .enrique-inner {
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
  }
  .enrique .head { color: var(--muted-on-dark); }
  .enrique h2 {
    font-size: clamp(52px, 8vw, 150px);
    line-height: 0.9;
    text-transform: uppercase;
    margin: 20px 0 0;
  }
  .enrique-grid {
    display: grid;
    grid-template-columns: minmax(240px, 340px) 1fr;
    gap: clamp(44px, 6vw, 110px);
    align-items: start;
    margin-top: clamp(44px, 6vh, 72px);
  }
  .portrait { margin: 0; }
  .portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: 0.85;
    object-fit: cover;
    display: block;
  }
  .credit {
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--muted-on-dark);
    margin-top: 12px;
  }
  .bio { max-width: 62ch; }
  .quote {
    /* Enrique's own words, in the site's handwriting face. */
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: clamp(28px, 2.8vw, 46px);
    line-height: 1.2;
    margin: 0 0 30px;
    max-width: 24ch;
    color: #fff;
  }
  .about {
    font-size: clamp(16px, 1.4vw, 20px);
    line-height: 1.65;
    margin: 0;
    max-width: 52ch;
    color: rgba(255, 255, 255, 0.8);
  }
  @media (max-width: 700px) {
    .enrique-grid { grid-template-columns: 1fr; }
    .portrait { max-width: 340px; }
  }

  /* --- How it started & the numbers (shared full-screen chunk styling) --- */
  .origin,
  .numbers { background: var(--ink); color: #fff; }
  .origin { position: relative; }
  /* Jump targets for the timeline rail dots. */
  .beat-anchor { position: absolute; width: 1px; height: 1px; }
  #beat-1 { top: 5%; }
  #beat-2 { top: 26%; }
  #beat-3 { top: 48%; }
  .rail { display: none; }
  .origin-frame {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
  }
