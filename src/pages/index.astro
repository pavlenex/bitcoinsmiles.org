                <path d="M153,175 Q158,180 163,175"></path>
                <path d="M152,182 L148,210 L168,210 L164,182 M152,182 Q158,186 164,182 M158,188 L158,208"></path>
                <circle cx="155" cy="194" r="0.9" fill="#fff" stroke="none"></circle>
                <circle cx="155" cy="200" r="0.9" fill="#fff" stroke="none"></circle>
                <path d="M152,186 C146,184 142,180 139,175 M139,175 l-7,-7 M134,166 l3.4,3.4 M136.5,163.5 l3.4,3.4 M139,161 l3.4,3.4"></path>
                <path d="M164,186 C170,188 174,192 176,196 M176,196 a3.6,3.6 0 1 0 0.1,0"></path>
                <path d="M152,210 L151,222 M165,210 L166,222 M151,222 l-5,1 M166,222 l5,1"></path>
              </g>
              <text x="252" y="230" font-size="17" fill="#9a9a9a" class="hand" stroke="none">Enrique</text>
            </g>
              </svg>
            </div>
            <div class="layer layer-network">
              <svg viewBox="0 0 380 310" class="scene">
                <g class="scene-network">
              <g fill="none" stroke="#fff" stroke-linecap="round" stroke-width="1.5">
                <circle cx="48" cy="30" r="5.5"></circle>
                <circle cx="150" cy="16" r="5.5"></circle>
                <circle cx="244" cy="24" r="5.5"></circle>
                <circle cx="26" cy="112" r="5.5"></circle>
                <circle cx="352" cy="108" r="5.5"></circle>
              </g>
              <g fill="none" stroke="#fff" stroke-width="1" opacity="0.3" stroke-dasharray="3 5">
                <path d="M54,32 L144,18"></path>
                <path d="M156,17 L238,23"></path>
                <path d="M46,36 L28,106"></path>
                <path d="M250,26 C290,50 330,80 348,103"></path>
              </g>
              <g fill="none" stroke="#fff" stroke-width="0.8" opacity="0.22" stroke-dasharray="2 6">
                <path id="satp1" d="M48,30 C120,70 220,110 330,172"></path>
                <path id="satp2" d="M352,108 C346,132 340,150 336,168"></path>
                <path id="satp3" d="M26,112 C100,160 210,180 316,184"></path>
                <path id="satp4" d="M244,24 C270,80 300,130 332,168"></path>
              </g>
              <g class="sats" fill="#f0a71f" stroke="none">
                <circle r="3"><animateMotion dur="3.6s" repeatCount="indefinite"><mpath href="#satp1"></mpath></animateMotion></circle>
                <circle r="3"><animateMotion dur="3.6s" begin="-1.8s" repeatCount="indefinite"><mpath href="#satp1"></mpath></animateMotion></circle>
                <circle r="3"><animateMotion dur="2.6s" begin="-0.9s" repeatCount="indefinite"><mpath href="#satp2"></mpath></animateMotion></circle>
                <circle r="3"><animateMotion dur="4s" repeatCount="indefinite"><mpath href="#satp3"></mpath></animateMotion></circle>
                <circle r="3"><animateMotion dur="4s" begin="-2.1s" repeatCount="indefinite"><mpath href="#satp3"></mpath></animateMotion></circle>
                <circle r="3"><animateMotion dur="3.2s" begin="-1.4s" repeatCount="indefinite"><mpath href="#satp4"></mpath></animateMotion></circle>
              </g>
              <text x="40" y="12" font-size="15" fill="#9a9a9a" class="hand">bitcoin community</text>
            </g>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Metrics: bordered grid; tiles animate in on the section timeline, counters count up on view -->
  <section class="numbers" aria-label="What the internet did">
    <div class="numbers-inner">
      <div class="metrics">
        <div class="metric m-1" style={metricScatter[0]}>
          <p class="figure"><span class="count" data-count="2971">2,971</span> people</p>
          <p class="mono caption">from all over the internet funded it</p>
        </div>
        <div class="metric m-2" style={metricScatter[1]}>
          <p class="figure"><span class="count" data-count="1.9" data-decimals="1">1.9</span> BTC</p>
          <p class="mono caption">received through self-hosted BTCPay Server so far</p>
        </div>
        <div class="metric m-3" style={metricScatter[2]}>
          <p class="figure"><span class="count" data-count="250">250</span>+</p>
          <p class="mono caption">patients treated in Enrique's chair, free of charge</p>
        </div>
        <div class="metric m-4" style={metricScatter[3]}>
          <p class="figure"><span class="count" data-count="66">66</span></p>
          <p class="mono caption">
            neighbours who had lost every tooth, with 132 complete dentures built from scratch
          </p>
        </div>
        <div class="metric m-5" style={metricScatter[4]}>
          <p class="figure"><span class="count" data-count="200">200</span></p>
          <p class="mono caption">children given preventive check-ups before the damage starts</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Patient grid; cards animate in on a shared section timeline -->
  <section class="smiles" id="smiles">
    <div class="smiles-inner">
      <h2 class="reveal" style="--r0:12%;--r1:45%">The smiles</h2>
      <div class="grid">
        {smiles.map(({ patient, photo, style }) => (
          <a class="card" href={`/patients/${patient.id}/`} style={style}>
            <div class="photo">
              <Image
                src={photo}
                alt={patient.data.name}
                widths={[300, 600]}
                sizes="(max-width: 520px) 44vw, (max-width: 1100px) 30vw, 300px"
              />
            </div>
            <div class="meta">
              <p class="name">{patient.data.name}</p>
              <p class="date">{monthYear(patient.data.date)}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Enrique -->
  <section class="enrique">
    <div class="enrique-inner">
      <p class="mono head">The hands that did the work</p>
      <h2>Enrique Berrios</h2>
      <div class="enrique-grid">
        <figure class="portrait">
          <Image
            src={enriquePhoto}
            alt="Dr. Enrique Berrios in his dental chair"
            widths={[287]}
            sizes="(max-width: 700px) 80vw, 340px"
          />
          <figcaption class="mono credit">Dr. Enrique Berrios · Diente Zonte</figcaption>
        </figure>
        <div class="bio">
          <p class="quote">
            "Surrounded by colourful birds, mango trees, snakes and insects, and of course the
            blue sky and ocean."
          </p>
          <p class="about">
            Every treatment documented here happened in Enrique's chair. The work is patient and
            practical: consultations, extractions, healing, fittings, adjustments and follow-up.
            Bitcoin changed who could help fund the care. It did not change the hands doing it or
            the trust built in the community over years.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What's next: Bitcoin Smiles II in Santa Ana -->
  <section class="santa" aria-label="What's next: Santa Ana">
    <div class="santa-inner">
      <div class="santa-copy">
        <p class="mono reveal">What's next · Santa Ana</p>
        <h2 class="reveal" style="--r0:14%;--r1:50%">From one chair to two</h2>
        <p class="santa-lead reveal" style="--r0:18%;--r1:55%">
          Bitcoin Smiles began in Enrique's small clinic in El Zonte. Now the team is preparing a
          second treatment room 163 kilometres away in Santa Ana, bringing the model closer to
          communities in western El Salvador.
        </p>
        <p class="santa-lead reveal" style="--r0:21%;--r1:58%">
          Families in El Ranchador and Ashuquema live far from regular health services, and much
          of the available work follows the seasonal coffee harvest. Community outreach has
          identified 64 families for the initial plan. Local volunteers plan to transport
          patients. A treatment room has been identified and a dental chair acquired. The next
          step is to install and equip it for care.
        </p>
      </div>
      <div class="santa-art reveal" style="--r0:16%;--r1:56%" aria-hidden="true">
