  /* --- Scroll-driven choreography (browsers with animation-timeline) ---
     Also gated on motion preference: the pinned/stacked layouts only make
     sense when the animations that resolve them are allowed to run. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* The original wall choreography: one shared timeline on the section,
         every card converging on the grid together as it arrives — staggered
         landings via --re, settling at exactly its grid position (no offsets —
         the grid must end up perfectly aligned). */
      .smiles { view-timeline: --fly block; }
      .card {
        animation: cardIn linear both;
        animation-timeline: --fly;
        animation-range: entry 60% contain var(--re, 10%);
      }
      .enrique .head {
        animation: chunk linear both;
        animation-timeline: view();
        animation-range: entry 10% entry 50%;
      }
      .enrique h2 {
        animation: numIn linear both;
        animation-timeline: view();
        animation-range: entry 15% entry 65%;
      }
