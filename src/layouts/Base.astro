---
import '@fontsource-variable/archivo';
import '@fontsource-variable/caveat';
import '@fontsource/space-mono';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DonateModal from '../components/DonateModal.astro';
import { SITE_NAME, SITE_DESCRIPTION, BTCPAY_HOST } from '../consts';
import defaultShareImage from '../photos/site/clinic.webp';

interface Props {
  title: string;
  description?: string;
  /** Image for social link previews; defaults to the clinic photo. */
  shareImage?: ImageMetadata;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = SITE_DESCRIPTION,
  shareImage = defaultShareImage,
  ogType = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: shareImage, width: 1200, format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site);

// GitHub Pages can't set response headers, so the policy ships as a meta tag.
// script-src 'unsafe-inline' is unavoidable: Astro emits every component's
// behaviour as an inline module. frame-ancestors does nothing in a meta tag,
// so clickjacking protection stays unsolved on Pages (needs a CDN for headers).
const btcpayOrigin = new URL(BTCPAY_HOST).origin;
const csp = [
  "default-src 'self'",
  `script-src 'self' 'unsafe-inline' ${btcpayOrigin}`,
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data:",
  "font-src 'self'",
  `connect-src 'self' ${btcpayOrigin}`,
  `frame-src ${btcpayOrigin}`,
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
  "upgrade-insecure-requests",
].join('; ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <DonateModal />
  </body>
</html>
