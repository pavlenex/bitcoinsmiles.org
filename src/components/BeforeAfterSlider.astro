---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Draggable before/after comparison: the after photo is the base layer, the
// before photo sits on top clipped to the left of a draggable divider.
// The whole frame is an invisible <input type="range">, so dragging, tapping,
// touch, keyboard arrows and screen readers all work with ~6 lines of JS.
interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  name?: string;
  sizes?: string;
}

const { before, after, name = '', sizes = '(max-width: 700px) 92vw, 430px' } = Astro.props;
const widths = [320, 480, 640, 720];
---

<div class="ba" data-ba-slider>
  <div class="frame">
    <Image src={after} alt={name ? `${name} after treatment` : 'After treatment'} {widths} {sizes} />
    <div class="lift" aria-hidden="true">
      <Image src={before} alt="" {widths} {sizes} />
    </div>
    <div class="divider" aria-hidden="true">
      <span class="knob">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 6 L4 12 L9 18M15 6 L20 12 L15 18" />
        </svg>
      </span>
    </div>
    <input
      type="range"
      min="0"
      max="100"
      step="0.5"
      value="50"
      aria-label={name ? `Compare ${name} before and after treatment` : 'Compare before and after treatment'}
    />
  </div>
  <div class="labels" aria-hidden="true">
    <p class="mono label">Before</p>
    <p class="mono label after-label">After</p>
  </div>
</div>

<style>
  .ba { --pos: 50%; }
  .frame {
    position: relative;
    overflow: hidden;
    background: #efefef;
  }
  .frame img {
    width: 100%;
    height: auto;
    aspect-ratio: 0.8;
    object-fit: cover;
    display: block;
  }
  .lift {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .lift img { height: 100%; }
  .divider {
    position: absolute;
    inset: 0 auto 0 var(--pos);
    width: 0;
    pointer-events: none;
  }
  .divider::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 -1px;
    width: 2px;
    background: #fff;
    box-shadow: 0 0 0 0.5px rgba(0, 0, 0, 0.35);
  }
  .knob {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #fff;
    border: 1.5px solid var(--ink);
    color: var(--ink);
    display: grid;
    place-items: center;
  }
  input[type='range'] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
    -webkit-appearance: none;
    appearance: none;
  }
  .frame:has(input:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  .labels {
    display: flex;
    justify-content: space-between;
    margin-top: 12px;
  }
  .label { font-size: 11px; letter-spacing: 0.16em; }
  .after-label { color: var(--ink); }
</style>

<script>
  for (const el of document.querySelectorAll<HTMLElement>('[data-ba-slider]')) {
    const range = el.querySelector<HTMLInputElement>('input[type="range"]');
    if (!range) continue;
    const set = () => el.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', set);
    set();
  }
</script>
