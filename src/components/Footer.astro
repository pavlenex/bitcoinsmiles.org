---
import { DONATE_URL, SITE_NAME } from '../consts';

// The dark closing section from the original homepage, shared by every page
// so no page dead-ends without a way to donate.
---

<footer>
  <div class="inner">
    <p class="mono open">The fund is still open</p>
    <h2>Make someone smile</h2>
    <div class="cta-row">
      <a class="cta" href={DONATE_URL} target="_blank" rel="noopener">Donate in Bitcoin</a>
    </div>
    <p class="mono colophon">{SITE_NAME} · El Zonte, El Salvador · every sat goes to the clinic</p>
  </div>
</footer>

<style>
  footer { background: var(--ink); color: #fff; }
  .inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 110px 48px 90px;
    text-align: center;
  }
  .open { color: var(--muted-on-dark); }
  h2 {
    font-size: clamp(52px, 8vw, 150px);
    line-height: 0.9;
    text-transform: uppercase;
    margin: 24px 0 0;
  }
  .cta-row { display: flex; justify-content: center; margin-top: 44px; }
  .cta {
    text-decoration: none;
    background: #fff;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 21px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 20px 54px;
  }
  .cta:hover { color: var(--ink); background: #ececec; }
  .colophon {
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--muted-on-dark);
    margin-top: 90px;
  }
  @media (max-width: 640px) {
    .inner { padding: 80px 24px 60px; }
  }
</style>
