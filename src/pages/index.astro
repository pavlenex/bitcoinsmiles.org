---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NeighbourhoodMap from '../components/NeighbourhoodMap.astro';
import { afterPhoto } from '../lib/photos';
import { SITE_NAME, monthYear } from '../consts';
import enriquePhoto from '../photos/site/enrique.jpg';

// Logo assets resolved by slug; every entry carries an outbound URL.
const supporterLogos = import.meta.glob<{ default: ImageMetadata }>(
  '../photos/supporters/*.png', { eager: true }
);
const pressLogos = import.meta.glob<{ default: ImageMetadata }>(
  '../photos/press/*.png', { eager: true }
);
const logo = (dir: Record<string, { default: ImageMetadata }>, slug: string) => {
  const mod = dir[Object.keys(dir).find((k) => k.endsWith(`/${slug}.png`) || k.endsWith(`/${slug}.jpg`)) ?? ''];
  if (!mod) throw new Error(`Missing logo asset: ${slug}`);
  return mod.default;
};
// Display height derived from aspect ratio so logos carry similar visual weight.
const logoHeight = (img: ImageMetadata) =>
  Math.max(24, Math.min(54, Math.round(66 / Math.sqrt(img.width / img.height))));

const patients = (await getCollection('patients')).sort((a, b) => a.data.order - b.data.order);

// Seeded PRNG (mulberry32) generates per-card flight custom properties at
// build time. Fixed seed keeps builds deterministic; new cards get values
// automatically.
function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = mulberry32(20210903);
const smiles = patients.map((p) => ({
  patient: p,
  photo: afterPhoto(p.id),
  style: [
    `--tx:${Math.round(rand() * 121 - 64)}vw`,
    `--ty:${Math.round(56 + rand() * 60)}vh`,
    `--tr:${Math.round(rand() * 34 - 18)}deg`,
    `--ts:${(1.5 + rand() * 1.15).toFixed(2)}`,
    `--re:${5 + Math.round(rand() * 15)}%`,
  ].join(';'),
}));

// Scatter values for the metric tiles; --re increases per tile to stagger landings.
const metricScatter = Array.from({ length: 5 }, (_, i) =>
  [
    `--tx:${Math.round(rand() * 81 - 40)}vw`,
    `--ty:${Math.round(40 + rand() * 50)}vh`,
    `--tr:${Math.round(rand() * 28 - 14)}deg`,
    `--ts:${(1.2 + rand() * 0.6).toFixed(2)}`,
    `--re:${42 + i * 13}%`,
  ].join(';')
);

const supporters = [
  { slug: '1bitcoin-ca', name: '1Bitcoin.ca', url: 'https://1bitcoin.ca/' },
  { slug: 'bitmymoney', name: 'Bitmymoney', url: 'https://www.bitmymoney.com/' },
  { slug: 'bitrefill', name: 'Bitrefill', url: 'https://www.bitrefill.com/' },
  { slug: 'blockstream', name: 'Blockstream', url: 'https://blockstream.com/' },
  { slug: 'cobra', name: 'Cobra', url: 'https://twitter.com/CobraBitcoin' },
  { slug: 'okcoin', name: 'Okcoin', url: 'https://www.okcoin.com/' },
  { slug: 'peakshift', name: 'Peakshift', url: 'https://peakshift.com/' },
  { slug: 'spending-bitcoin', name: 'Spending Bitcoin', url: 'https://spending-bitcoin.com/' },
  { slug: 'square', name: 'Square', url: 'https://squareup.com/' },
  { slug: 'swan', name: 'Swan', url: 'https://www.swanbitcoin.com/' },
  { slug: 'the-bitcoin-company', name: 'The Bitcoin Company', url: 'https://twitter.com/TheBtcCompany' },
  { slug: 'the-biz', name: 'The Biz with John Carvalho', url: 'https://thebiz.pro/' },
  { slug: 'wallet-of-satoshi', name: 'Wallet of Satoshi', url: 'https://walletofsatoshi.com/' },
].map((x) => ({ ...x, img: logo(supporterLogos, x.slug) }));

const press = [
  { slug: 'forbes', name: 'Forbes', url: 'https://www.forbes.com/sites/martinrivers/2021/12/31/how-bitcoin-is-giving-elderly-el-salvadorians-a-reason-to-smile/' },
  { slug: 'bitcoinmagazine', name: 'Bitcoin Magazine', url: 'https://bitcoinmagazine.com/business/el-salvador-bitcoin-smiles-raising-btc' },
  { slug: 'beincrypto', name: 'BeInCrypto', url: 'https://es.beincrypto.com/dentista-el-salvador-lanza-campana-recaudar-btc-atender-zonas-rurales/' },
].map((x) => ({ ...x, img: logo(pressLogos, x.slug) }));

---

<Base title={`${SITE_NAME} · Bring smiles back to the neighbourhood`}>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <h1>Bring smiles back to the neighbourhood</h1>
        <p>
          In 2021, one call about Bitcoin in El Zonte became a global effort to fund free dental
          care. 2,971 people donated, while volunteers and companies across the Bitcoin community
          helped build and share the fundraiser. Nearly five years later, their support is still
          bringing neighbours into the dentist's chair.
        </p>
      </div>
      <div class="hero-map">
        <NeighbourhoodMap />
      </div>
    </div>
  </section>

  <!-- Origin: pinned section; chapters crossfade on the section timeline, scene layers accumulate, rail dots are jump links -->
  <section class="origin" aria-label="How it all started">
    <div class="beat-anchor" id="story"></div>
    <div class="beat-anchor" id="beat-1"></div>
    <div class="beat-anchor" id="beat-2"></div>
    <div class="beat-anchor" id="beat-3"></div>
    <div class="beat-anchor" id="beat-4"></div>
    <div class="origin-pin">
      <div class="origin-frame">
        <nav class="rail" aria-label="Story beats">
          <span class="rail-line" aria-hidden="true"><span class="rail-fill"></span></span>
          <a class="dot d-1" href="#beat-1"><span>the village</span></a>
          <a class="dot d-2" href="#beat-2"><span>the dentist</span></a>
          <a class="dot d-3" href="#beat-3"><span>the call</span></a>
          <a class="dot d-4" href="#beat-4"><span>the community</span></a>
        </nav>
        <div class="beats">
          <div class="chapter ch-1">
            <div class="beat-copy">
              <p class="figure">El Zonte under the world's spotlight</p>
              <p class="desc">
                Bitcoin Beach had already spent two years showing how Bitcoin could work in daily
                life. When El Salvador passed a law in June 2021 to make Bitcoin legal tender, the
                world looked to El Zonte to understand what adoption meant. Beyond the headlines,
                many local families still could not afford basic dental care.
              </p>
            </div>
          </div>
          <div class="chapter ch-2">
            <div class="beat-copy">
              <p class="figure">Enrique had treated neighbours since 2005</p>
              <p class="desc">
                Enrique Berrios had already spent sixteen years treating neighbours who could not
                pay. A dental internship brought him to the mountains above El Zonte around 2005.
                He stayed and opened the area's first dental office in a six-by-four-metre room
                surrounded by jungle. Bitcoin Smiles did not create his mission. It gave a global
                community a way to join it.
              </p>
            </div>
          </div>
          <div class="chapter ch-3">
            <div class="beat-copy">
              <p class="figure">From Bitcoin adoption to dental care</p>
              <p class="desc">
                In 2021, Enrique took a call from Pavlenex, an open-source Bitcoin contributor who
                wanted to understand how people in El Salvador were using Bitcoin. They had never
                met. Enrique explained that many neighbours still could not afford dental care.
                The call ended with a simple idea: put the clinic's need online and let anyone,
                anywhere, help with Bitcoin.
              </p>
            </div>
          </div>
          <div class="chapter ch-4">
            <div class="beat-copy">
              <p class="figure">2,971 donors funded years of care</p>
              <p class="desc">
                The call became an open invitation. People around the world sent bitcoin.
                Volunteers helped build and share the fundraiser, while companies across the
                Bitcoin space backed the effort. Together, 2,971 donors turned one clinic's need
                into years of free dental care for neighbours who otherwise could not afford
                treatment.
              </p>
            </div>
          </div>
        </div>
        <div class="stage" aria-hidden="true">
          <div class="scene-stack">
            <svg viewBox="0 0 380 310" class="scene">
              <g class="scene-base" fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6">
