---
import Base from '../layouts/Base.astro';
import { SITE_NAME } from '../consts';
---

<Base title={`Page not found · ${SITE_NAME}`}>
  <section>
    <p class="mono">404</p>
    <h1>This page is missing a tooth</h1>
    <p class="lead">The address doesn't exist. The stories and the fund are still here:</p>
    <div class="links">
      <a href="/">The story</a>
      <a href="/patients/">The patients</a>
    </div>
  </section>
</Base>

<style>
  section {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    max-width: 1400px;
    margin: 0 auto;
    padding: 130px var(--pad-x) 80px;
  }
  h1 {
    font-size: clamp(40px, 6vw, 96px);
    line-height: 0.95;
    text-transform: uppercase;
    margin: 20px 0 0;
    max-width: 16ch;
  }
  .lead {
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--body-text);
    margin: 26px 0 0;
  }
  .links {
    display: flex;
    gap: 28px;
    margin-top: 34px;
  }
  .links a { font-size: 17px; font-weight: 700; }
</style>
