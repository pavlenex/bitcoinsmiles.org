              <path d="M330,194 c0,-4.8 3,-7.8 7,-7.8 c4,0 7,3 7,7.8 c0,3 -1.1,5.1 -2,7.2 c-1,2.4 -1,5.1 -1.6,7.5 c-0.4,1.6 -2.2,1.7 -2.5,0 c-0.4,-1.9 -0.4,-4.2 -1.9,-4.2 c-1.5,0 -1.4,2.3 -1.9,4.2 c-0.3,1.7 -2.1,1.6 -2.5,0 c-0.6,-2.4 -0.6,-5.1 -1.6,-7.5 c-0.9,-2.1 -2,-4.2 -2,-7.2 z" stroke="none" fill="#fff"></path>
